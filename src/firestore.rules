@'
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reminderSubs/{token} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'tz', 'water', 'meals', 'fee', 'updatedAt'])
        && request.resource.data.token == token
        && request.resource.data.meals.size() <= 8;
      allow delete: if true;
    }
    match /gymFee/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['on', 'plan', 'paidOn', 'time', 'nextDue', 'history', 'updatedAt'])
        && request.resource.data.plan in [1, 3, 6, 9, 12];
      allow delete: if code.size() >= 20;
    }
  }
}
'@ | Set-Content -Path firestore.rules -Encoding ascii
